ENVIRONMENT=development
MAX_UPLOAD_SIZE_MB=500
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# YOLO26 supporting vision layer (object detection/tracking, additive to the
# anomaly pipeline above). All optional -- defaults shown match
# app/core/config.py.
YOLO_MODEL_NAME=yolo26s.pt
YOLO_INPUT_SIZE=640
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE=auto
YOLO_FRAME_STRIDE=1
