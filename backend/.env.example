ENVIRONMENT=development
MAX_UPLOAD_SIZE_MB=500
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# YOLO26 supporting vision layer (object detection/tracking, additive to the
# anomaly pipeline above). All optional -- defaults shown match
# app/core/config.py.
YOLO_MODEL_NAME=yolo26s.pt
YOLO_INPUT_SIZE=640
YOLO_CONFIDENCE_THRESHOLD=0.25
YOLO_IOU_THRESHOLD=0.45
YOLO_DEVICE=auto
YOLO_FRAME_STRIDE=1

# SMS Gateway (Android phone acting as a physical SMS modem over local
# Wi-Fi/hotspot). Isolated notification feature -- disabled by default and
# NOT wired into anomaly detection. See app/services/sms_gateway.py.
# Do not put real credentials in this file -- copy to .env and fill there.
SMS_GATEWAY_ENABLED=false
SMS_GATEWAY_URL=
SMS_GATEWAY_USERNAME=
SMS_GATEWAY_PASSWORD=

# MongoDB Atlas -- permanent persistence layer. See app/core/mongodb.py.
# Do not put a real URI here -- copy this file to .env and fill it there.
# The backend starts cleanly even if this is unset/unreachable; only
# persistent-data operations will then report a truthful connectivity error.
MONGODB_URI=
MONGODB_DATABASE=sentinel_x

# Voluntary live location sharing (share-link feature). See
# app/core/share_tokens.py and app/api/routes/share.py.
# Do not put a real secret here -- copy this file to .env and fill it there.
# If left unset, a random key is generated at process start (logged as a
# warning) so dev still works, but issued links won't survive a restart.
SENTINEL_SHARE_SECRET_KEY=
# How long an SMS'd invitation link is valid for first use (seconds).
SHARE_INVITE_TTL_SECONDS=900
# How long an already-started tracking session may keep posting location
# updates, independent of the invite link's own expiry (seconds).
SHARE_SESSION_MAX_DURATION_SECONDS=7200
# Externally-reachable base URL used only to build the share link text sent
# in the dispatch SMS (e.g. the ngrok HTTPS URL during testing). Leave unset
# for local-only testing.
PUBLIC_BASE_URL=
