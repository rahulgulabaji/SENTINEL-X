# SENTINEL-X frontend environment configuration.
# Copy to .env and fill in real values. .env is gitignored (see root .gitignore).

# Base URL of the real FastAPI backend.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Map tile provider (CartoDB/Carto Voyager or similar). Leave blank until
# the Map API is provided — the dark/OSM tile layers do not require a key.
VITE_MAP_TILE_URL=
VITE_MAP_TILE_API_KEY=
